#!/usr/bin/env sh

##############################################################################
# Husky pre-commit hook
##############################################################################
#
# WHY THIS EXISTS:
# This file is executed by Husky (a git hooks manager) every time the
# developer runs `git commit`. It invokes our `gate:run` command which
# runs the entire quality gate pipeline.
#
# HOW IT BLOCKS COMMITS:
# Git hooks follow the Unix convention: exit code 0 = success, non-zero = failure.
# If `gate:run` calls `this.error()` (which Oclif translates to process.exit(2)),
# this script exits with a non-zero code, and git aborts the commit.
#
# HOW TO BYPASS (escape hatch):
# Sometimes you need to commit despite gate failures (e.g., WIP commits):
#
#   git commit --no-verify -m "WIP: work in progress"
#
# The --no-verify flag tells git to skip all hooks.
#
# INSTALLATION:
# Husky automatically symlinks this file when you run `npx husky init` or
# when the `prepare` script in package.json runs (`husky`). The `prepare`
# script runs automatically after `npm install`.
##############################################################################

npx devai gate:run
